# Server-side Express API base URL. The default assumes Express listens on port 4000 locally.
TALVIRO_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Optional public API origin for future browser-safe public requests only.
# Never place passwords, JWT secrets, database credentials, or provider secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional server-only AI provider settings for the floating assistant.
# Never expose provider keys through NEXT_PUBLIC_* variables.
TALVIRO_AI_API_URL=https://api.openai.com/v1/chat/completions
TALVIRO_AI_API_KEY=
TALVIRO_AI_MODEL=
