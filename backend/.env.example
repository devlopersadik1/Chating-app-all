NODE_ENV=production
# cPanel normally injects PORT; do not hardcode it unless your host requires it.
CORS_ORIGIN=https://talvirochat.sites.bd
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_database
DB_USER=your_cpanel_database_user
DB_PASSWORD=replace_with_database_password

# Absolute writable directory outside public_html. Replace CPANEL_USERNAME.
MEDIA_STORAGE_DIR=/home/CPANEL_USERNAME/private/talviro-media

# Generate a unique random secret (at least 32 characters); never use this example value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# SMTP for password reset emails. Use a provider app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME=Talviro Chat
MAIL_FROM_ADDRESS=youraddress@gmail.com
PASSWORD_RESET_URL=https://talvirochat.sites.bd/reset-password
