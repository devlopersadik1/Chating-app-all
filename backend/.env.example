NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_database
DB_USER=your_cpanel_database_user
DB_PASSWORD=replace_with_database_password
# Generate a unique random secret (at least 32 characters); never use this example value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Use a private directory outside public_html for uploaded media.
MEDIA_STORAGE_DIR=/home/your_cpanel_username/talviro-private/media

# SMTP for password reset emails (Gmail requires a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_character_google_app_password
MAIL_FROM_NAME=Talviro Chat
MAIL_FROM_ADDRESS=youraddress@gmail.com
PASSWORD_RESET_URL=https://your-domain.example/reset-password
